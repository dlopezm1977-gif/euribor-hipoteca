rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /euribor_history/{date} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /mortgages/{mortgageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
